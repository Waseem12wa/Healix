# Frontend API Configuration (local dev)
# Vite dev server proxies /api/* to http://localhost:5000 (see vite.config.ts),
# so leaving these as relative paths is recommended. They are shown here for clarity.
VITE_API_BASE_URL=/api/assistant
VITE_MEDICAL_RECORD_API_BASE_URL=/api/medical-record

# Stripe Configuration
# Get your publishable key from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdefghijk

# Optional: For production
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_production_key
