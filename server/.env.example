# Core runtime
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# CORS (comma-separated)
# Example: https://healix.vercel.app,https://healix-git-main-yourname.vercel.app
ALLOWED_ORIGINS=https://healix.vercel.app
FRONTEND_URL=https://healix.vercel.app

# Optional: choose strict startup readiness for required services
REQUIRED_MICROSERVICES=DDI,DFI,ALT,SIDE,HEALTH

# Internal microservice URLs (same Render service, loopback inside container)
DDI_SERVICE_URL=http://127.0.0.1:5001
DFI_SERVICE_URL=http://127.0.0.1:5002
ALTERNATIVE_SERVICE_URL=http://127.0.0.1:5003
SIDE_EFFECT_SERVICE_URL=http://127.0.0.1:5004
MEDICAL_RECORD_SERVICE_URL=http://127.0.0.1:5005
HEALTH_ASSISTANT_SERVICE_URL=http://127.0.0.1:5006

# Email
USE_RESEND=true
RESEND_API_KEY=
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_DEV_MODE=false

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BACKEND_URL=https://your-backend.onrender.com
NAYAPAY_SUCCESS_URL=https://healix.vercel.app/shop/orders
NAYAPAY_FAILURE_URL=https://healix.vercel.app/shop/checkout?status=failed

# Object storage (optional)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
