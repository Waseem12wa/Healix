# Core runtime
# For LOCAL DEVELOPMENT: Set to 'development' (CORS will auto-allow localhost)
# For PRODUCTION: Set to 'production' (CORS requires ALLOWED_ORIGINS config)
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection
# Format: mongodb+srv://username:password@cluster.mongodb.net/healix?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/healix?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=30d

# CORS Configuration
# For LOCAL DEVELOPMENT (NODE_ENV=development):
#   - Automatically allows all localhost variants (5173, 5174, 3000, 8000, etc.)
#   - No need to set ALLOWED_ORIGINS
#
# For PRODUCTION deployment on Render/Vercel:
#   - Set NODE_ENV=production
#   - Set ALLOWED_ORIGINS to your Vercel domain (comma-separated if multiple)
#   - Example: https://healix-rg6p.vercel.app,https://healix-preview.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOW_VERCEL_PREVIEW_ORIGINS=true

# Microservices
# DDI (Drug-Drug Interaction) - port 5001
# DFI (Drug-Food Interaction) - port 5002  
# ALT (Medicine Alternatives) - port 5003
# SIDE (Side Effects) - port 5004
# MEDREC (Medical Records) - port 5005
# HEALTH (Health Assistant) - port 5006
REQUIRED_MICROSERVICES=DDI,DFI,ALT,SIDE,HEALTH,MEDREC

# Internal microservice URLs (localhost for local dev, loopback for Render)
DDI_SERVICE_URL=http://127.0.0.1:5001
DFI_SERVICE_URL=http://127.0.0.1:5002
ALTERNATIVE_SERVICE_URL=http://127.0.0.1:5003
SIDE_EFFECT_SERVICE_URL=http://127.0.0.1:5004
MEDICAL_RECORD_SERVICE_URL=http://127.0.0.1:5005
HEALTH_ASSISTANT_SERVICE_URL=http://127.0.0.1:5006

# Email (optional for local dev)
USE_RESEND=false
RESEND_API_KEY=
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_DEV_MODE=true

# Payments (optional for local dev)
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=
BACKEND_URL=http://localhost:5000
NAYAPAY_SUCCESS_URL=http://localhost:5173/shop/orders
NAYAPAY_FAILURE_URL=http://localhost:5173/shop/checkout?status=failed

# Object storage (optional)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
